# --- Chain config --- (Robinhood Chain mainnet)
CHAIN_ID=4663
CHAIN_NAME=robinhood-chain

# Primary RPC — use a provider (Alchemy) for the live indexer hot path.
RPC_HTTP_URL=https://robinhood-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# eth_subscribe WS (e.g. Alchemy). Leave blank to poll.
# NOTE: wss://feed.*.chain.robinhood.com is the Arbitrum sequencer feed, NOT JSON-RPC.
RPC_WS_URL=wss://robinhood-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Wide eth_getLogs scans only (pool backfill). Public RPC allows full block
# ranges; Alchemy's free tier caps getLogs at 10 blocks. Defaults to RPC_HTTP_URL.
BACKFILL_RPC_URL=https://rpc.mainnet.chain.robinhood.com

BLOCKSCOUT_API_URL=https://robinhoodchain.blockscout.com/api/v2

# Testnet:
# CHAIN_ID=46630
# CHAIN_NAME=robinhood-chain-testnet
# RPC_HTTP_URL=https://rpc.testnet.chain.robinhood.com
# BACKFILL_RPC_URL=https://rpc.testnet.chain.robinhood.com
# BLOCKSCOUT_API_URL=https://explorer.testnet.chain.robinhood.com/api/v2

# --- Database ---
# Local docker (docker compose up -d):
DATABASE_URL=postgres://rhchain:rhchain@localhost:5432/rhchain_analytics
DATABASE_SSL=disable
DATABASE_POOL_MAX=3

# Supabase: use the "Session pooler" string (Project → Connect → Session pooler).
# It's IPv4 and port 5432, safe for the indexer's transactions. Not the
# "Transaction pooler" (6543) and not the direct db.<ref>.supabase.co host
# (IPv6-only without the paid IPv4 add-on).
# DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DATABASE_SSL=no-verify
# DATABASE_POOL_MAX=5

# --- Redis ---
# Unused in Phase 1 — leave blank. Needed once the Phase 2 cache layer lands
# (local docker, or a managed provider like Upstash).
REDIS_URL=

# --- Indexer behavior ---
INDEXER_POLL_INTERVAL_MS=2000

# --- API ---
API_PORT=3001
API_RATE_LIMIT_PER_MIN=60

LOG_LEVEL=info
