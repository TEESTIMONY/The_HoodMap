{
  "name": "robinhood-chain-analytics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "migrate": "tsx src/db/migrate.ts",
    "migrate:status": "tsx src/db/migrate.ts --status",
    "db:reset": "node scripts/db-reset.mjs",
    "db:analyze": "node scripts/db-analyze.mjs",
    "backfill:pools": "tsx src/scripts/backfillPools.ts",
    "backfill:token-meta": "tsx src/scripts/sweepTokenMeta.ts",
    "reclassify:tokens": "tsx src/scripts/reclassifyTokens.ts",
    "dev": "node scripts/dev.mjs",
    "dev:indexer": "tsx watch src/indexer/index.ts",
    "dev:api": "tsx watch src/api/index.ts",
    "dev:stats": "tsx watch src/workers/statistics.ts",
    "stats:once": "tsx -e \"import('./src/analytics/statistics.js').then(m=>m.refreshStatistics()).then(r=>{console.log(r);process.exit(0)})\"",
    "compare": "tsx src/scripts/compare.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"dist/**/*.test.js\"",
    "start:migrate": "node dist/db/migrate.js",
    "start:indexer": "node dist/indexer/index.js",
    "start:api": "node dist/api/index.js"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.0",
    "ioredis": "^5.4.1",
    "pg": "^8.12.0",
    "pino": "^9.3.0",
    "pino-pretty": "^11.2.1",
    "viem": "^2.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.1.0",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4"
  }
}
